<!--map.wxml-->
<view class="homepage">
  <!-- 地图区域 -->
  <map 
    class="map" 
    id="map" 
    longitude="120.177598" 
    latitude="30.227838" 
    scale="12" 
    markers="{{markers}}" 
    covers="{{covers}}" 
    show-location="{{true}}"
    enable-compass="{{true}}"
    enable-zoom="{{true}}"
    enable-scroll="{{true}}"
    enable-rotate="{{true}}"
    bindtap="onMapTap"
  ></map>
  
  <!-- 下方数据展示区域 -->
  <view class="data-container">
    <!-- 搜索框 -->
    <view class="search-box">
      <image src="/images/icon_search.png" class="search-icon" />
      <input type="text" placeholder="搜索地点或场馆" class="search-input" bindblur="onSearchBlur" bindconfirm="onSearchConfirm" />
    </view>
    
    <!-- 推荐内容 -->
    <view class="recommend-section">
      <!-- 空状态 -->
      <view wx:if="{{courses.length === 0 && !loading}}" class="empty-state">
        <text class="empty-text">暂无数据</text>
      </view>
      <!-- 数据列表 -->
      <view wx:else class="recommend-list">
        <view wx:for="{{courses}}" wx:key="id" class="recommend-item">
          <view class="item-info">
            <view class="item-name">
              <text>{{item.name}}</text>
              <view class="navigation">
                <image src="/images/icon_navigation.png" class="navigation-img" />
                <text>0.5km</text>
              </view>
            </view>
            <view class="item-desc">{{item.address}}</view>
            <view class="item-meta">
              <view class="distance">
                <view class="ball ball-blue">{{item.venueTypeName}}</view>
              </view>
              <view class="rating" bindtap="onTapDetail" data-id="{{item.id}}">
                <text>详情</text>
                <image src="/images/icon_arrow.png" class="arrow-img" />
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>