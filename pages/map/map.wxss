/* map.wxss */
.homepage {
  /* display: flex;
  flex-direction: column; */
  height: 100%;
  width: 100%;
  background-color: #f5f5f5;
}

/* 地图区域 */
.map {
  width: 100%;
  height: 50vh;
}

/* 数据展示容器 */
.data-container {
  flex: 1;
  max-height: 50vh;
  min-height: 48vh;
  background-color: #fff;
  border-radius: 20rpx 20rpx 0 0;
  /* margin-top: -20rpx; */
  padding: 20rpx;
  box-shadow: 0 -5rpx 15rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 10rpx;
  padding: 15rpx;
  margin-bottom: 20rpx;
  /* margin-top: 16rpx; */
}

.search-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 15rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  background-color: transparent;
}

/* 快捷按钮 */
.quick-buttons {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
  display: none;
}

.quick-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 22%;
  padding: 20rpx 0;
  background-color: #f8f8f8;
  border-radius: 15rpx;
}

.quick-btn-icon {
  width: 50rpx;
  height: 50rpx;
  margin-bottom: 10rpx;
}

.quick-btn text {
  font-size: 24rpx;
  color: #333;
}

/* 推荐内容 */
.recommend-section {
  flex: 1;
  /* max-height: 50vh; */
  overflow-y: auto;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.recommend-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.recommend-item {
  display: flex;
  /* background-color: #fafafa; */
  border-radius: 15rpx;
  overflow: hidden;
  padding: 15rpx;
  padding-bottom: 32rpx;
  border-bottom: 2rpx solid #EDEDED;
  /* box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05); */
}

.item-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-name {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.ball {
  padding: 6rpx 8rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
}

.ball-blue {
  background: #E3F4FF;
  color: #019EFF;
}

.ball-green {
  background: rgba(221,255,243,0.82);
  color: #00CD85;
}

.ball-origin {
  background: #FFF3E3;
  color: #FF9E17;
}

.navigation {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 48rpx;  
  padding: 0 16rpx;
  background: #019EFF;
  border-radius: 28rpx;
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 400;
}

.navigation-img {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.item-desc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.distance {
  display: flex;
  align-items: center;
  font-size: 20rpx;
}

.rating {
  display: flex;
  align-items: center;
  font-weight: 400;
  font-size: 28rpx;
  color: #666666;
  letter-spacing: 2rpx;
}

.arrow-img {
  width: 32rpx;
  height: 32rpx;
  margin-top: 2rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 300rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}