/* detail.wxss */
.detail-container {
  padding: 30rpx;
  padding-bottom: 100rpx;
  /* background-color: #ffffff; */
}

/* 标题区域 */
.detail-header {
  margin-bottom: 30rpx;
}

.detail-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  line-height: 1.5;
  display: block;
  margin-bottom: 15rpx;
}

.detail-time {
  font-size: 24rpx;
  color: #999999;
}

/* 图片区域 */
.detail-image-container {
  margin-bottom: 30rpx;
  border-radius: 10rpx;
  overflow: hidden;
}

.detail-image {
  width: 100%;
  height: 400rpx;
  background-color: #f7f7f7;
}

/* 描述区域 */
.detail-description {
  font-size: 30rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 30rpx;
  padding: 20rpx;
  background-color: #f7f7f7;
  border-radius: 10rpx;
}

/* 内容区域 */
.detail-content {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.8;
  margin-bottom: 40rpx;
}

.detail-content text {
  display: block;
  margin-bottom: 20rpx;
  white-space: pre-wrap;
}

/* 图片列表样式 */
.image-grid {
  margin-top: 20rpx;
}

.image-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.image-item {
  width: calc(50% - 10rpx);
  border-radius: 24rpx;
  overflow: hidden;
  background-color: pink;
}

.image-item image {
  width: 100%;
  height: 200rpx;
  display: block;
}

/* 底部操作区域 */
.detail-share {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-weight: 500;
  font-size: 32rpx;
  color: #333333;
  font-weight: bold;
  margin-top: 32rpx;
  /* padding: 20rpx 30rpx; */
  /* box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05); */
}

.share-btn {
  background: #019EFF;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #FFFFFF;
  padding: 6rpx 24rpx;
}

.list-item {
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  /* box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05); */
  transition: transform 0.2s;
}

.list-item:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.list-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.header-name {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999999;
}

.header-name image {
  width: 54rpx;
  height: 48rpx;
  margin-right: 12rpx;
}

.header-status {
  background: #00CD85;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #FFFFFF;
  padding: 4rpx 24rpx;
}

.list-item-title {
  font-weight: 600;
  font-size: 36rpx;
  color: #333333;
  margin-top: 24rpx;
}

.list-item-desc {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 15rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  border-bottom: 1rpx solid #EDEDED;
  padding-bottom: 20rpx;
}

.list-item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
}

.footer-info {
  flex: 1;
  position: relative;
}

.footer-info-right {
  padding-left: 32rpx;
}

.right-line {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
  height: 64rpx;
  background: #EDEDED;
}

.footer-info-top {
  display: flex;
  align-items: center;
  color: #666666;
}

.footer-info-top image {
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
}

.footer-info-bottom {
  /* padding-left: 60rpx; */
}

.footer-info-bottom .value {
  font-weight: bold;
  font-size: 48rpx;
  color: #333333;
  margin-right: 6rpx;
}

.list-item-time {
  font-size: 24rpx;
  color: #999999;
}