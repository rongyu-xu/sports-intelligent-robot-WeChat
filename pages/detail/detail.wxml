<!--detail.wxml-->
<view class="detail-container">
  <!-- 标题区域 -->
  <view class="list-item">
    <view class="list-item-header">
      <view class="header-name">
        <image src="/images/icon_date.png" mode=""/>
        <view>课程时间：{{detail.time || '--'}}</view>
      </view>
    </view>
    <view class="list-item-title">{{detail.title || '--'}}</view>
    <view class="list-item-desc">{{detail.description || '--'}}</view>
    <view class="list-item-footer">
      <view class="footer-info">
        <view class="footer-info-top">
          <text>训练时长</text>
        </view>
        <view class="footer-info-bottom">
          <text class="value">{{detail.durationMinutes || '--'}}</text>
          <text>分钟</text>
        </view>
      </view>
      <view class="footer-info footer-info-right">
        <view class="right-line" />
        <view class="footer-info-top">
          <text>学员人数</text>
        </view>
        <view class="footer-info-bottom">
          <text class="value">{{detail.totalStudentCount || '--'}}</text>
          <text>人</text>
        </view>
      </view>
      <view class="footer-info footer-info-right">
        <view class="right-line" />
        <view class="footer-info-top">
          <text>实到人数</text>
        </view>
        <view class="footer-info-bottom">
          <text class="value">{{detail.attendanceCount || '--'}}</text>
          <text>人</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 分享 -->
  <view class="detail-share">
    <text>精彩瞬间</text>
    <view open-type="share" class="share-btn">
      一键分享
    </view>
  </view>

  <!-- 内容区域 -->
  <view class="detail-content">
    <!-- 图片列表 -->
    <view class="image-grid">
      <view class="image-row" wx:for="{{imageList}}" wx:for-item="item" wx:for-index="index" wx:key="index" wx:if="{{index % 2 === 0}}">
        <view class="image-item">
          <image src="{{item}}" mode="aspectFill" bindtap="previewImage" data-index="{{index}}"/>
        </view>
        <view class="image-item" wx:if="{{index + 1 < imageList.length}}">
          <image src="{{imageList[index + 1]}}" mode="aspectFill" bindtap="previewImage" data-index="{{index + 1}}"/>
        </view>
      </view>
    </view>
    
    <!-- 课程详情 -->
    <view class="detail-text">
      <view wx:for="{{contentLines}}" wx:key="index" class="content-line">
        {{item}}
      </view>
    </view>
  </view>
</view>