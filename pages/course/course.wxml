<!--course.wxml-->
<view class="container" style="padding-top: {{listPaddingTop}}px; ">
  <!-- 背景图片 -->
  <view class="container_img">
    <image src="/images/bg1.png" alt=""/>
  </view>
  
  <!-- 自定义标题栏，使用动态样式适配不同机型 -->
  <view class="custom-nav-bar" style="height:{{navBarHeight + statusBarHeight}}px; background-color:{{navBarBgColor}}; transition: background-color 0.3s ease;">
    <!-- 状态栏占位 -->
    <view class="status-bar" style="height:{{statusBarHeight}}px;"></view>
    <!-- 标题区域 -->
    <view class="title-container" style="height:{{navBarHeight}}px;">
      <view class="title">课程</view>
    </view>
  </view>

  <view class="container_placehold" style="height:{{navBarHeight + statusBarHeight}}px; background-color:{{navBarBgColor}}; transition: background-color 0.3s ease;"></view>
  
  <!-- 列表内容区域 -->
  <scroll-view scroll-y="true" class="list-container" style="height: calc(100vh - {{listPaddingTop + 12 }}px);">
    <view class="list">
      <block wx:for="{{courses}}" wx:key="id">
        <view class="list-item" bindtap="onCourseTap" data-id="{{item.id}}">
          <view class="list-item-header">
            <view class="header-name">
              <image src="/images/icon_date.png" mode=""/>
              <view>{{item.time}}</view>
            </view>
            <view class="header-status">{{item.status}}</view>
          </view>
          <view class="list-item-title">{{item.title}}</view>
          <view class="list-item-desc">{{item.description}}</view>
          <view class="list-item-footer">
            <view class="footer-info">
              <view class="footer-info-top">
                <image src="/images/icon_time.png" mode=""/>
                <text>课程时长</text>
              </view>
              <view class="footer-info-bottom">
                <text class="value">{{item.duration}}</text>
                <text>分钟</text>
              </view>
            </view>
            <view class="footer-info footer-info-right">
              <view class="right-line" />
              <view class="footer-info-top">
                <image src="/images/icon_completion.png" mode=""/>
                <text>完成度</text>
              </view>
              <view class="footer-info-bottom">
                <text class="value">{{item.difficulty}}</text>
                <text>%</text>
              </view>
            </view>
          </view>
        </view>
      </block>
      <view wx:if="{{courses.length === 0}}" class="empty">
        暂无课程数据
      </view>
    </view>
  </scroll-view>
</view>