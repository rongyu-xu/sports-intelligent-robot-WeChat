/* user.wxss */
.user-container {
  position: relative;
  padding-top: 60rpx;
  padding-bottom: 100rpx;
  box-sizing: border-box;
  padding: 32rpx;
  min-height: 100vh;
  overflow: hidden;
}

.container-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
}

.container-img image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 用户信息区域 */
.user-info {
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  /* padding: 40rpx 30rpx; */
  /* background-color: #1AAD19; */
  color: #666666;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
}

.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background-color: rgba(255, 255, 255, 0.3);
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 60rpx;
}

.nickname {
  font-weight: 500;
  font-size: 32rpx;
  color: #333333;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.phone {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 16rpx;
  margin-top: 6rpx;
}

.studentId {
  font-size: 24rpx;
  color: #666666;
}

.login-btn {
  margin-top: 10rpx;
  background-color: #ffffff;
  color: #1AAD19;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

/* 功能菜单区域 */
.menu-container {
  margin-top: 20rpx;
  background-color: #ffffff;
  border-radius: 32rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background-color 0.2s;
}

.menu-item:active {
  background-color: #f7f7f7;
}

.menu-title {
  display: flex;
  align-items: center;
}

.menu-title image {
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
}

.menu-text {
  flex: 1;
  font-size: 32rpx;
  color: #333333;
}

.menu-arrow {
  color: #cccccc;
  font-size: 36rpx;
}

/* 关于我们 */
.about-section {
  margin-top: 20rpx;
  padding: 30rpx;
  text-align: center;
}

.version {
  color: #999999;
  font-size: 24rpx;
}