/* pages/growth/growth.wxss */
.container {
  position: relative;
  width: 100%;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.background-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 400rpx;
  z-index: 0;
  opacity: 0.8;
}

.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 10;
  display: flex;
  flex-direction: column;
}

.status-bar {
  width: 100%;
}

.nav-bar-content {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

.stats-overview {
  display: flex;
  justify-content: space-around;
  padding: 20rpx;
  margin-top: 200rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  margin: 200rpx 20rpx 0 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 1;
  position: relative;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a73e8;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #666666;
}

.section {
  margin: 30rpx 20rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 1;
  position: relative;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
  display: block;
}

.achievements {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.achievement-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  border-radius: 16rpx;
  background-color: #f8f9fa;
  border: 1px solid #e0e0e0;
}

.achievement-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 12rpx;
}

.achievement-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.achievement-desc {
  font-size: 22rpx;
  color: #666666;
  text-align: center;
}

.progress-chart {
  margin-bottom: 30rpx;
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  background-color: #e0e0e0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  background-color: #1a73e8;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 24rpx;
  color: #666666;
  text-align: center;
}

.milestones {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.milestone-item {
  display: flex;
  padding: 20rpx;
  border-radius: 12rpx;
  background-color: #f8f9fa;
  border-left: 4rpx solid #1a73e8;
}

.milestone-time {
  font-size: 22rpx;
  color: #999999;
  min-width: 140rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
}

.milestone-content {
  flex: 1;
}

.milestone-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 4rpx;
  display: block;
}

.milestone-desc {
  font-size: 22rpx;
  color: #666666;
}
