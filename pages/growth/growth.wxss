/* pages/growth/growth.wxss */
.container {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  overflow-x: hidden;
}

/* 背景图片样式 - 保持固定效果 */
.container_img {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  z-index: 1;
  overflow: hidden;
}

.container_img image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  top: 0;
  left: 0;
}

/* 自定义标题栏样式 */
.custom-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 30;
}

.status-bar {
  width: 100%;
}

.title-container {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 14;
}

.title {
  position: relative;
  z-index: 3;
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  text-align: center;
}

.container_placehold {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 20;
}

/* 列表容器样式 - 确保不与顶部内容重叠 */
.list-container {
  position: relative;
  z-index: 5;
  width: 100%;
  box-sizing: border-box;
}

/* 成长数据概览 */
.stats-overview {
  display: flex;
  /* justify-content: space-around; */
  padding: 20rpx;
  border-radius: 20rpx;
  margin: 20rpx;
  margin-top: 12rpx;
  color: #fff;
  z-index: 1;
  position: relative;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.stat-avatar {
  width: 128rpx;
  height: 128rpx;
  margin-right: 32rpx;
}

.stat-name {
  font-size: 36rpx;
  font-weight: 700;
}

.stat-label {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.section {
  margin: 30rpx 20rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 1;
  position: relative;
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
  display: block;
}

/* 综合评价区域样式 */
.achievements {
  margin: 30rpx 20rpx;
  position: relative; /* 相对定位，使内部绝对定位元素基于此定位 */
  background-color: transparent; /* 设置为透明，让图片显示 */
  border-radius: 20rpx;
  padding: 16rpx 30rpx;
  z-index: 1;
  overflow: hidden; /* 确保背景图不超出容器 */
}

/* 背景图片样式 */
.achievements-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 1148rpx;
  z-index: -1; /* 将图片置于内容下层 */
  border-radius: 20rpx;
}
.achievements-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

.title-score {
  font-size: 60rpx;
  color: #019EFF;
}

.title-unit {
  font-size: 28rpx;
}

.evaluate {
  display: block;
  font-weight: 500;
  font-size: 28rpx;
  color: #FF9E17;
}

.tips {
  font-size: 28rpx;
  color: #666666;
  line-height: 44rpx;
}

.achievements-line {
  width: 96%;
  height: 2rpx;
  background: #EDEDED;
  margin-left: 2%;
  margin-top: 48rpx;
}

.achievement-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 12rpx;
}

.achievement-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.achievement-desc {
  font-size: 22rpx;
  color: #666666;
  text-align: center;
}

/* 图表容器样式 */
.achievements-charts {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.chart-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
  width: 100%;
}

.chart-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 10rpx;
}
.progress-chart {
  margin-bottom: 30rpx;
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  background-color: #e0e0e0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  background-color: #1a73e8;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 24rpx;
  color: #666666;
  text-align: center;
}

.milestones {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  font-weight: 400;
  font-size: 28rpx;
  color: #333;
}

.milestones-text {
  color: #666;
}

.milestones-source {
  color: #FF9E17;
}

.milestone-time {
  font-size: 22rpx;
  color: #999999;
  min-width: 140rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
}

.milestone-content {
  flex: 1;
}

.milestone-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 4rpx;
  display: block;
}

.milestone-desc {
  font-size: 22rpx;
  color: #666666;
}