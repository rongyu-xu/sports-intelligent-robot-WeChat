/* index.wxss */
.container {
  position: relative;
  /* padding-bottom: 100rpx; */
  box-sizing: border-box;
  min-height: 100vh;
  overflow-x: hidden;
}

/* 背景图片样式 - 保持固定效果 */
.container_img {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  z-index: 1;
  overflow: hidden;
}

.container_img image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  top: 0;
  left: 0;
}

/* 自定义标题栏样式 */
.custom-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 30;
}

.status-bar {
  width: 100%;
}

.title-container {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 14;
  position: relative;
}

.back-button {
  position: absolute;
  left: 16rpx;
  width: 60rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 36rpx;
  height: 36rpx;
  transform: rotate(180deg);
}

.title {
  position: relative;
  z-index: 3;
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  text-align: center;
}

.container_placehold {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 20;
}

/* 列表容器样式 - 确保不与顶部内容重叠 */
.list-container {
  position: relative;
  z-index: 5;
  width: 100%;
  box-sizing: border-box;
  /* 基础样式，padding-top 将由动态样式覆盖 */
}

.list {
  position: relative;
  width: 100%;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999999;
  font-size: 28rpx;
}

.introduction {
  background-color: #fff;
  border-radius: 15rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 24rpx;
}

.item-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}

.venue-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding-bottom: 32rpx;
  border-bottom: 2rpx solid #EDEDED;
}

.item-name {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.ball {
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
}

.ball-text {
  font-size: 24rpx;
  color: #666666;
  line-height: 40rpx;
}

.ball-blue {
  background: #E3F4FF;
  color: #019EFF;
}

.ball-green {
  background: rgba(221,255,243,0.82);
  color: #00CD85;
}

.ball-origin {
  background: #FFF3E3;
  color: #FF9E17;
}

.navigation {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 48rpx;  
  padding: 0 16rpx;
  background: #019EFF;
  border-radius: 28rpx;
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 400;
}

.navigation-img {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.item-desc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.distance {
  display: flex;
  align-items: center;
  font-size: 20rpx;
}

.rating {
  display: flex;
  align-items: center;
  font-weight: 400;
  font-size: 28rpx;
  color: #666666;
  letter-spacing: 2rpx;
}

.arrow-img {
  width: 32rpx;
  height: 32rpx;
  margin-top: 2rpx;
}

.venue-brief {
  margin-top: 24rpx;
}

.brief-text {
  font-size: 24rpx;
  color: #666666;
}

.brief-title {
  font-size: 24rpx;
  color: #333333;
}

.brief-logo {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.logo {
  flex-shrink: 0;
  width: 160rpx;
  height: 160rpx;
  margin-right: 16rpx;
}

/* 通用标题样式 */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin: 0 0 16rpx 0;
  display: block;
}

/* 教练力量样式 */
.coaches-section {
  margin-bottom: 32rpx;
}

.coaches-scroll {
  white-space: nowrap;
  margin: 0 -16rpx;
}

.coaches-container {
  display: flex;
  padding: 0 16rpx;
}

.coach-item {
  width: 180rpx;
  margin-right: 24rpx;
  text-align: center;
}

.coach-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
}

.coach-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.coach-title {
  font-size: 24rpx;
  color: #666666;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 智能设备样式 */
.equipment-section {
  margin-bottom: 32rpx;
}

.equipment-list {
  display: grid;
  grid-template-columns: repeat(1, 1fr);
  gap: 16rpx;
}

.equipment-item {
  display: flex;
  align-items: center;
  border-radius: 12rpx;
}

.equipment-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  display: block;
  
}

.equipment-count {
  font-size: 24rpx;
  color: #888888;
  display: block;
  line-height: 40rpx;
  margin: 6rpx 0;
}

.equipment-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 40rpx;
}

/* 学员评价样式 */
.reviews-section {
  margin-bottom: 32rpx;
}

.reviews-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.review-item {
  background-color: #f8f9fa;
  padding: 24rpx;
  border-radius: 12rpx;
}

.review-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.review-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.review-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-right: auto;
}

.star-rating {
  display: flex;
  align-items: center;
}

.star {
  margin-left: 4rpx;
}

.star-icon {
  font-size: 24rpx;
  color: #FFD700;
}

.review-content {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
  text-align: justify;
}